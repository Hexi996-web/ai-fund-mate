# PostgreSQL 连接池地址，仅配置在服务端和数据任务环境中。
DATABASE_URL=postgresql://user:password@host:5432/ai_fund_mate
DATABASE_POOL_SIZE=3
DATABASE_SSL=require

# 现有产品经理 Agent 配置。
AGENT_API_KEY=
AGENT_MODEL=
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_PROVIDER=openai-compatible

# 动态报告模型：兼容 Kimi、DeepSeek、OpenAI 等 OpenAI-compatible API。
ANALYSIS_PROVIDER=
ANALYSIS_API_KEY=
ANALYSIS_MODEL=
ANALYSIS_BASE_URL=
ANALYSIS_PROMPT_VERSION=v1
